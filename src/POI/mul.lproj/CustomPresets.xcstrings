    "ScT-zG-GwL.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Inherit the presets of this feature. If none then selecting this feature will merge (not replace) the tags onto the target object.\"; ObjectID = \"ScT-zG-GwL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdědit předvolby této funkce. Pokud nejsou žádné, vybraní této funkce sloučí (nenahradí) značky s cílovým objektem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inherit the presets of this feature. If none then selecting this feature will merge (not replace) the tags onto the target object."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warisi preset dari fitur ini. Jika tidak ada, memilih fitur ini akan menggabungkan (bukan mengganti) tag ke objek target."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наследовать пресеты данной функции. Если не выбрано, то функция совместит (не заменит) теги на выбранном объекте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu özelliğin ön ayarlarını devralır. Ön ayar yoksa bu özelliğin seçilmesi durumunda etiketler hedef nesneye birleştirilir (yerine geçmez)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼承這圖徵的預設組合，如果沒有選取這圖徵則會合併 (不是取代) 標籤到目標物件。"
          }
        }
      }
    },
