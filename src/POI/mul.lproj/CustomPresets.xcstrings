    "Dfv-TT-J6i.footerTitle" : {
      "comment" : "Class = \"UITableViewSection\"; footerTitle = \"The preset will be available when editing objects matching this key/value combination. Leave either blank for wildcard.\"; ObjectID = \"Dfv-TT-J6i\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolba bude dostupná při úpravách objektů shodujících se s touto kombinací klíče a hodnoty. Ponechte prázdné, nebo použijte hvězdičku."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The preset will be available when editing objects matching this key/value combination. Leave either blank for wildcard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preset akan tersedia saat mengedit objek yang cocok dengan kombinasi kunci/nilai ini. Kosongkan salah satu atau keduanya untuk wildcard."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот пресет будет доступен, когда будут обрабатываться объекты с совпадающей комбинацией ключ/значение. Оставьте любое из полей пустым, чтобы использовать подстановочный знак."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu anahtar/değer kombinasyonuna uyan nesneleri düzenlerken bu ön ayar kullanılabilir olacaktır. Joker karakter kullanmak için ikisinden birini boş bırakın."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你編輯的物件吻合這個鍵/值組合時，預設組合將會出現。可以留空採萬用字元。"
          }
        }
      }
    },
